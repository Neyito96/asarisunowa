  const STANDALONE = new RegExp(`^[\\p{Script=Han}\\p{Script=Katakana}ー々]{1,4}[\\p{Script=Hiragana}]{1,4}$`, 'u'); // 「金澤ひかり」のようにひらがなを含む名は、その行に単独で書かれている時だけ採る
  const matches = [];
