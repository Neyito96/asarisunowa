    line=line.replace(/(?:この番組は|※)?毎週[月火水木金土日]曜日に配信します。?/g,m=>{removed.push({reason:'COMMON_SCHEDULE',text:m});return '';});
    line=line.replace(urlPattern,u=>publicationUrl(u)||'').trim();if(line&&!body.includes(line))body.push(line);
